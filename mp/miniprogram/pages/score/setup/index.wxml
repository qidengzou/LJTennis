<view class="page">
  <view class="card">
    <view class="row-between">
      <text class="k">赛制</text>
      <view class="chip">赛事已设定</view>
    </view>
    <text class="fmt">{{formatLabel}}</text>
  </view>

  <view class="fld">
    <text class="k">谁先发球</text>
    <view class="seg">
      <view class="seg-i {{firstSide === 0 ? 'on' : ''}}" data-v="0" bindtap="onSide">{{m.a[0]}} / {{m.a[1]}}</view>
      <view class="seg-i {{firstSide === 1 ? 'on' : ''}}" data-v="1" bindtap="onSide">{{m.b[0]}} / {{m.b[1]}}</view>
    </view>
  </view>

  <view class="fld">
    <text class="k">{{m.a[0]}} / {{m.a[1]}} 谁先发</text>
    <view class="seg">
      <view class="seg-i {{aFirst === 0 ? 'on' : ''}}" data-v="0" bindtap="onAFirst">{{m.a[0]}}</view>
      <view class="seg-i {{aFirst === 1 ? 'on' : ''}}" data-v="1" bindtap="onAFirst">{{m.a[1]}}</view>
    </view>
  </view>

  <view class="fld">
    <text class="k">{{m.b[0]}} / {{m.b[1]}} 谁先发</text>
    <view class="seg">
      <view class="seg-i {{bFirst === 0 ? 'on' : ''}}" data-v="0" bindtap="onBFirst">{{m.b[0]}}</view>
      <view class="seg-i {{bFirst === 1 ? 'on' : ''}}" data-v="1" bindtap="onBFirst">{{m.b[1]}}</view>
    </view>
  </view>

  <view class="card order">
    <text class="k">发球顺序（自动推导）</text>
    <view class="order-row">
      <block wx:for="{{serveOrder}}" wx:key="index">
        <view class="dot" wx:if="{{index === 0}}"></view>
        <text class="on-name">{{item}}</text>
        <text class="arrow" wx:if="{{index < 3}}">→</text>
      </block>
      <text class="arrow">→ 循环</text>
    </view>
  </view>

  <button class="btn btn-primary start" bindtap="onStart">开始</button>
  <view class="safe-bottom"></view>
</view>
