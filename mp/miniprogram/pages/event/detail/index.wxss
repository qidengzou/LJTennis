.page { padding: 24rpx; display: flex; flex-direction: column; gap: 20rpx; min-height: 100vh; }
.ev { display: flex; flex-direction: column; gap: 16rpx; }
.ev-n { font-size: 38rpx; font-weight: 600; color: var(--c-ink); }
.full { font-size: var(--t-caption); color: var(--c-live); }
.bar { height: 10rpx; background: var(--c-surface-2); border-radius: var(--r-full); overflow: hidden; }
.bar-i { height: 100%; background: var(--c-brand); border-radius: var(--r-full); }
.bar-i.f { background: var(--c-live); }
.banner { background: var(--c-brand-weak); color: var(--c-brand); border-radius: var(--r-m); padding: 22rpx 26rpx; font-size: var(--t-caption); line-height: 1.6; }
.sec { margin-top: 12rpx; }
.list { padding: 8rpx 28rpx; }
.prow { display: flex; align-items: center; gap: 22rpx; padding: 22rpx 0; border-bottom: 2rpx solid var(--c-line); }
.prow:last-child { border-bottom: 0; }
.prow.empty { justify-content: center; }
.av { width: 72rpx; height: 72rpx; border-radius: var(--r-full); display: flex; align-items: center; justify-content: center; color: var(--c-on-av); font-size: 28rpx; font-weight: 600; flex: none; }
.nm { flex: 1; min-width: 0; display: flex; flex-direction: column; gap: 4rpx; }
.nm-t { font-size: var(--t-h3); color: var(--c-ink); }
.center { text-align: center; }
.dock { margin-top: auto; padding-top: 24rpx; }
