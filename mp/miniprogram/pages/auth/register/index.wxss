/* 注册是照片页：底图不走深浅模式；全局也已关掉暗黑（app.json darkmode:false）*/
.root {
  position: relative;
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  overflow: hidden;
  color: var(--c-on-photo);
}

.bg {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  z-index: 0;
}

.scrim {
  position: absolute;
  inset: 0;
  z-index: 1;
  background: linear-gradient(
    180deg,
    rgba(16, 26, 52, .52) 0%,
    rgba(16, 26, 52, .26) 26%,
    rgba(16, 26, 52, .32) 58%,
    rgba(12, 22, 46, .68) 100%
  );
}

/* 深色模式加重一档：从深色 tab 跳进来不会闪白 */

.nav, .hero, .sheet, .dock {
  position: relative;
  z-index: 2;
}

.nav {
  display: flex;
  align-items: center;
  padding-left: 20rpx;
  height: 88rpx;
  box-sizing: content-box;
}
.back {
  width: 72rpx;
  height: 72rpx;
  border-radius: var(--r-full);
  background: rgba(255, 255, 255, .22);
  display: flex;
  align-items: center;
  justify-content: center;
}
.back-on { opacity: .7; }
.back-i { font-size: 48rpx; line-height: 1; margin-top: -6rpx; color: var(--c-on-photo); }

.hero {
  padding: 8rpx 40rpx 20rpx;
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}
.hero-k {
  font-size: 20rpx;
  letter-spacing: .28em;
  font-weight: 600;
  opacity: .82;
}
.hero-t {
  font-size: 56rpx;
  font-weight: 700;
  letter-spacing: .04em;
  line-height: 1.15;
}
.hero-s { font-size: var(--t-caption); opacity: .78; }

.sheet-wrap {
  position: relative;
  z-index: 2;
  flex: 1;
  min-height: 0;
}

.sheet {
  margin: 0 28rpx;
  padding: 28rpx 28rpx 20rpx;
  border-radius: 28rpx;
  background: rgba(255, 255, 255, .9);
  box-shadow: var(--e-2);
  display: flex;
  flex-direction: column;
  gap: 22rpx;
  color: var(--c-ink);
}
.fld { display: flex; flex-direction: column; gap: 10rpx; }
.lbl { font-size: var(--t-micro); color: var(--c-ink-3); letter-spacing: .08em; }
/* <input> 是原生组件，垂直 padding 不撑它的内部行盒，也不吃 page 的
   line-height —— 只写 padding 会渲染成固有高度（约 36rpx），比性别
   分段矮一大截。三个控件统一钉到 88rpx（≈44pt，iOS 标准点击区）。 */
.inp {
  height: 88rpx;
  box-sizing: border-box;
  padding: 0 22rpx;
  background: var(--c-surface-2);
  border-radius: var(--r-m);
  font-size: 30rpx;
  color: var(--c-ink);
}
.ph { color: var(--c-ink-3); }
.hint { font-size: var(--t-micro); color: var(--c-ink-3); }

.phone-row { display: flex; gap: 12rpx; align-items: stretch; }
.grow { flex: 2; min-width: 0; }
/* 两个副按钮几何一致：与 .grow 的 2 构成 2:1，各占约 1/3 */
.wx-btn, .reset-btn {
  flex: 1;
  min-width: 0;
  height: 88rpx;
  box-sizing: border-box;
  padding: 0;
  margin: 0;
  border-radius: var(--r-m);
  font-size: 28rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
}
.wx-btn.full { flex: none; width: 100%; }
.wx-btn::after, .reset-btn::after { border: none; }
.wx-btn    { background: var(--c-wx);     color: var(--c-on-wx); }
.reset-btn { background: var(--c-danger); color: var(--c-on-danger); }

/* 已授权：只读展示。号码要云函数拿 code 去换，客户端只知道「授权过了」 */
.filled {
  height: 88rpx;
  box-sizing: border-box;
  padding: 0 22rpx;
  background: var(--c-surface-2);
  border-radius: var(--r-m);
  font-size: 30rpx;
  color: var(--c-ink);
  display: flex;
  align-items: center;
  gap: 12rpx;
}
/* 假数据角标：绝不能让人把 mock 号当成真号 */
.tag {
  margin-left: auto;
  padding: 2rpx 12rpx;
  border-radius: var(--r-full);
  background: var(--c-live);
  color: var(--c-on-photo);
  font-size: 20rpx;
  font-weight: 600;
}
.ok { width: 14rpx; height: 14rpx; border-radius: var(--r-full); background: var(--c-wx); }


.seg { display: flex; background: var(--c-surface-2); border-radius: var(--r-m); padding: 6rpx; gap: 4rpx; }
.seg-i {
  flex: 1;
  height: 76rpx;          /* +.seg 的 padding 6×2 = 88rpx，与 .inp 齐平 */
  line-height: 76rpx;
  text-align: center;
  padding: 0 4rpx;
  border-radius: 12rpx;
  font-size: 30rpx;
  color: var(--c-ink-2);
}
.seg-i.on { background: var(--c-surface); color: var(--c-ink); font-weight: 600; box-shadow: var(--e-1); }

.fld-h { display: flex; align-items: baseline; justify-content: space-between; }

.slider { position: relative; height: 104rpx; }
.rail {
  position: absolute; left: 22rpx; right: 22rpx; top: 30rpx;
  height: 8rpx; border-radius: 4rpx; background: var(--c-surface-2);
}
.rail.fill { right: auto; background: var(--c-brand); }
.ticks { position: absolute; left: 0; right: 0; top: 0; bottom: 0; display: flex; justify-content: space-between; }
.tick { width: 44rpx; display: flex; flex-direction: column; align-items: center; gap: 16rpx; }
.dot { width: 12rpx; height: 12rpx; border-radius: var(--r-full); margin-top: 28rpx; }
.tv { font-family: var(--f-num); font-size: 24rpx; }
.thumb {
  position: absolute; top: 12rpx; width: 44rpx; height: 44rpx; margin-left: -22rpx;
  border-radius: var(--r-full); background: var(--c-surface);
  border: 6rpx solid var(--c-brand); box-shadow: 0 4rpx 16rpx rgba(20, 24, 33, .22);
}


.dock {
  flex: none;
  padding: 24rpx 40rpx calc(20rpx + env(safe-area-inset-bottom));
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 20rpx;
}

.serve {
  width: 100%;
  padding: 28rpx;
  border-radius: var(--r-m);
  background: var(--c-brand);
  color: var(--c-brand-ink);
  font-size: 32rpx;
  font-weight: 600;
  letter-spacing: .12em;
  line-height: 1;
  box-shadow: 0 12rpx 32rpx rgba(46, 79, 216, .38);
}
.serve::after { border: none; }
.serve:active { opacity: .85; }
/* 资料没填完：降透明但仍可点 —— 点了会提示缺什么，比灰掉不给反馈好 */
.serve.off {
  background: rgba(255, 255, 255, .22);
  color: var(--c-on-photo);
  box-shadow: none;
}

.legal {
  font-size: 20rpx;
  color: rgba(255, 255, 255, .86);
}
