.wrap { height: 100vh; display: flex; flex-direction: column; background: var(--c-ground); }
.cv { flex: 1; width: 100%; }
.bar {
  padding: 20rpx 28rpx calc(24rpx + env(safe-area-inset-bottom));
  background: var(--c-surface); border-top: 2rpx solid var(--c-line);
  display: flex; align-items: center; justify-content: space-between; gap: 20rpx;
}
.hint { font-size: var(--t-caption); color: var(--c-ink-3); }
.btns { display: flex; gap: 14rpx; }
.mini {
  border: 2rpx solid var(--c-line); border-radius: var(--r-full);
  padding: 10rpx 24rpx; font-size: var(--t-caption); color: var(--c-ink-2);
}
.mini.on { background: var(--c-brand-weak); border-color: var(--c-brand); color: var(--c-brand); font-weight: 600; }
