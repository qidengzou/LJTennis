.page { padding: 24rpx; display: flex; flex-direction: column; gap: 20rpx; min-height: 100vh; }
.hero { display: flex; flex-direction: column; align-items: center; gap: 18rpx; padding: 44rpx 32rpx; }
.av { width: 104rpx; height: 104rpx; border-radius: var(--r-full); display: flex; align-items: center; justify-content: center; color: var(--c-on-av); font-size: 40rpx; font-weight: 600; }
.t { font-size: 38rpx; font-weight: 600; color: var(--c-ink); }
.kv { display: flex; flex-direction: column; gap: 20rpx; }
.v { font-size: var(--t-h3); color: var(--c-ink); }
/* 「谁付钱」用主色强调 —— 被邀请方第一个念头就是要不要自己掏钱 */
.v.pay { color: var(--c-brand); font-weight: 600; }
.cd { display: flex; align-items: center; justify-content: space-between; border-radius: var(--r-m); padding: 22rpx 26rpx; font-size: var(--t-caption); background: rgba(245,165,36,.12); color: var(--c-live); }
.cd.urgent { background: rgba(224,41,75,.12); color: var(--c-loss); }
.cd .num { font-size: var(--t-set); font-weight: 600; }
.center { text-align: center; }
.dock { margin-top: auto; padding-top: 24rpx; display: flex; flex-direction: column; gap: 16rpx; }
