.page { padding: 24rpx; display: flex; flex-direction: column; }
.hero { outline: 4rpx solid var(--c-brand); outline-offset: -4rpx; }
.mt8 { margin-top: 16rpx; }
.mt16 { margin-top: 24rpx; }
.mb10 { margin-bottom: 20rpx; }
.mr6 { margin-right: 12rpx; }
.sec { margin: 32rpx 0 16rpx; }
.dot { width: 10rpx; height: 10rpx; border-radius: 999rpx; background: currentColor; }
.pair-name { font-size: var(--t-h3); color: var(--c-ink); }
.dim .pair-name, .dim .sc { color: var(--c-ink-3); }
.sc { font-size: var(--t-set); color: var(--c-ink); letter-spacing: 4rpx; }
.sync { margin-top: 20rpx; font-size: var(--t-caption); color: var(--c-live); text-align: center; }
.opponent { display: block; margin: 12rpx 0 8rpx; font-size: 36rpx; font-weight: 600; color: var(--c-ink); }
.t-name { display: block; margin: 12rpx 0 8rpx; font-size: var(--t-h3); font-weight: 600; color: var(--c-ink); }
.ev-tags { display: flex; }
