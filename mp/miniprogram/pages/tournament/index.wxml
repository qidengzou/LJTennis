<view class="page">
  <!-- 今日比赛区：记分让出了 tab 位，靠这一区置顶把比赛日压回 2 tap -->
  <block wx:if="{{resume}}">
    <view class="card hero">
      <view class="row-between">
        <view class="chip chip-live"><view class="dot"></view>进行中</view>
        <text class="k">{{resume.eventName}}</text>
      </view>
      <view class="row-between mt16">
        <text class="pair-name">{{resume.a[0]}} / {{resume.a[1]}}</text>
        <text class="sc num">{{resumeScore.a}}</text>
      </view>
      <view class="row-between mt8 dim">
        <text class="pair-name">{{resume.b[0]}} / {{resume.b[1]}}</text>
        <text class="sc num">{{resumeScore.b}}</text>
      </view>
      <view class="sync">未同步 · 已本地保存</view>
      <button class="btn btn-primary mt16" bindtap="onResume">继续记分</button>
    </view>
  </block>

  <block wx:elif="{{today}}">
    <view class="card hero">
      <view class="row-between">
        <text class="k">下一场 · {{today.eventName}}</text>
        <view class="chip chip-brand">{{today.time}}</view>
      </view>
      <text class="opponent">{{today.b[0]}} / {{today.b[1]}}</text>
      <text class="k">{{today.tournament}} · {{today.court}}</text>
      <button class="btn btn-primary mt16" bindtap="onStart">进入记分</button>
      <button class="btn btn-secondary mt8" bindtap="onDraw">查看签表</button>
    </view>
    <view class="k sec">今日其他场次</view>
    <view class="card mb10" wx:for="{{otherToday}}" wx:key="id">
      <view class="row-between">
        <text>{{item.eventName}}</text>
        <text class="k">{{item.time}} · {{item.court}}</text>
      </view>
    </view>
  </block>

  <view class="k sec">报名中</view>
  <view class="card mb10" wx:for="{{tournaments}}" wx:key="id" data-id="{{item.id}}" bindtap="onTournament">
    <view class="row-between">
      <view class="chip chip-win">报名中</view>
      <text class="k">{{item.deadline}}</text>
    </view>
    <text class="t-name">{{item.name}}</text>
    <text class="k">{{item.date}} · {{item.venue}}</text>
    <view class="row-between mt8">
      <view class="ev-tags">
        <view class="chip mr6" wx:for="{{item.events}}" wx:for-item="ev" wx:key="*this">{{ev}}</view>
      </view>
      <text class="k">{{item.fee}}</text>
    </view>
  </view>

  <view class="safe-bottom"></view>
</view>
